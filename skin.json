{
  "name": "Rosé Pine Dawn",
  "author": "AkaCMD",
  "description": "A Rosé Pine Dawn light theme for the Steam desktop client, library, settings, and store.",
  "version": "1.0.0",
  "tags": [
    "Rosé Pine",
    "Light",
    "Minimal"
  ],
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetCss": [
        "css/light.css",
        "css/steam.css",
        "css/library-game.css",
        "css/downloads.css",
        "css/store.css"
      ]
    }
  ]
}
